# Frontend Environment Variables (.env.example)
# Copy this to .env.local (Vercel) and fill in your actual values

# API Base URL (use when deployed)
EXPO_PUBLIC_API_BASE_URL=https://myntra-backend.onrender.com

# Development API URL (comment out for production)
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# App Environment
EXPO_PUBLIC_ENV=production

# Analytics (optional)
EXPO_PUBLIC_ANALYTICS_ID=your-analytics-id

# Feature Flags (optional)
EXPO_PUBLIC_ENABLE_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_RECOMMENDATIONS=true
EXPO_PUBLIC_ENABLE_DARK_MODE=true
