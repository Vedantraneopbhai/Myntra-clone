# Backend Environment Variables (.env.example)
# Copy this to .env and fill in your actual values

# MongoDB Connection String (get from MongoDB Atlas)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/myntra_clone?appName=Cluster0

# Server Port (keep as 5000 for local, Render will override)
PORT=5000

# Node Environment
NODE_ENV=development

# CORS Origin (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,https://your-frontend.vercel.app

# JWT Secret (for future implementation)
JWT_SECRET=your-secret-key-here

# Email Configuration (for future notifications)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Firebase/Push Notification Keys (optional)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-key

# Sentry Error Tracking (optional)
SENTRY_DSN=your-sentry-dsn
